# Backend Runtime Configuration (NEVER commit real .env to Git)
PORT=8080

# LiveKit Cloud or Self-Hosted LiveKit Server
# Example Cloud: wss://your-project.livekit.cloud
# Example Self-Hosted: wss://rtc.yourdomain.com
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Firebase Auth verification (must match your Android app Firebase project ID)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Admin access control (comma-separated Firebase UIDs with SUPER_ADMIN access, or explicit uid:role map)
ADMIN_UIDS=admin_uid_1
# Optional RBAC role map (uid1:SUPER_ADMIN,uid2:FINANCE_ADMIN,uid3:MODERATION_ADMIN,uid4:AGENCY_MANAGER)
ADMIN_ROLE_MAP=
# Hardened x-admin-key (disabled in NODE_ENV=production; requires individual x-admin-actor-uid + IP allowlist)
ADMIN_API_KEY=replace_with_strong_random_admin_key
ADMIN_KEY_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1
ADMIN_CONSOLE_ACTOR_UIDS=
ALLOW_ADMIN_API_KEY_IN_PROD=false

# Firebase Admin Bridge (Service Account JSON for custom claims sync & instant token revocation on Ban/Suspend)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Automated Stream/Chat Moderation (Vision SafeSearch / Sightengine / OpenAI Moderation)
MODERATION_PROVIDER=
MODERATION_DAILY_BUDGET_USD=5
MODERATION_DAILY_MAX_SAMPLES=3300
MODERATION_SAMPLE_INTERVAL_SEC=45
GOOGLE_VISION_API_KEY=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
OPENAI_API_KEY=

# JSON persistence file path (for single-instance deployment; swap with PostgreSQL for multi-instance)
DATA_FILE=./data/calls-store.json

# PostgreSQL Authoritative Ledger (optional in local dev; required for multi-instance production)
DATABASE_URL=postgres://ayer:ayer_password@localhost:5432/ayer_prod
PG_SSL=false

# Google Play Billing Server-Side Verification (Service Account JSON with androidpublisher scope)
ANDROID_PACKAGE_NAME=com.aistudio.ayer.live
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Keep false in production! Only set true in isolated local dev without Firebase Auth.
ALLOW_DEV_AUTH=false

# WP-0 Feature Flags (Fail-Closed: default false until all financial/security gates pass)
PAYOUTS_ENABLED=false
MISSION_REWARDS_ENABLED=false
PAID_MEDIA_ENABLED=false
AGENCIES_ENABLED=false
