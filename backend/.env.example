# Backend Runtime Configuration (NEVER commit real .env to Git)
PORT=8080

# LiveKit Cloud or Self-Hosted LiveKit Server
# Example Cloud: wss://your-project.livekit.cloud
# Example Self-Hosted: wss://rtc.yourdomain.com
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Firebase Auth verification (must match your Android app Firebase project ID)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Admin access control (comma-separated Firebase UIDs with admin access, and optional admin API key)
ADMIN_UIDS=admin_uid_1
ADMIN_API_KEY=replace_with_strong_random_admin_key

# JSON persistence file path (for single-instance deployment; swap with Firestore/Postgres for multi-instance)
DATA_FILE=./data/calls-store.json

# Keep false in production! Only set true in isolated local dev without Firebase Auth.
ALLOW_DEV_AUTH=false
